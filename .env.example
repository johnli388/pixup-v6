# Local simulation only; real money processing is intentionally not enabled.
APP_MODE=demo
# auto enables Stripe-hosted test checkout when a test secret key is present.
# Set demo to use only local simulated payments, including browser fixtures.
PAYMENT_PROVIDER=auto
STRIPE_SECRET_KEY=
# Optional locally: the API also polls saved sessions for confirmation.
# Set this to the signing secret from `stripe listen` to verify webhook delivery.
STRIPE_WEBHOOK_SECRET=
PORT=4000
APP_ORIGIN=http://127.0.0.1:3000
API_INTERNAL_URL=http://127.0.0.1:4000
# Without DATABASE_URL, embedded PostgreSQL persists in .data/pixup.
# DATABASE_URL=postgresql://pixup:local-development-only@127.0.0.1:5432/pixup
DATA_DIR=.data/pixup
SEED_DEMO=true

