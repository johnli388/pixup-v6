# Local simulation only; real money processing is intentionally not enabled.
APP_MODE=demo
# auto enables Stripe-hosted test checkout when a test secret key is present.
# Set demo to use only local simulated payments, including browser fixtures.
PAYMENT_PROVIDER=auto
STRIPE_SECRET_KEY=
# Optional locally: the API also polls saved sessions for confirmation.
# Set this to the signing secret from `stripe listen` to verify webhook delivery.
STRIPE_WEBHOOK_SECRET=
# Optional expected platform account; keys are always test-only.
STRIPE_ACCOUNT_ID=
# Explicitly enabled sandbox countries; empty disables hosted Connect onboarding.
CONNECT_TEST_COUNTRIES=
# Enables independently approved transfers to connected test balances, not bank payouts.
CONNECT_TEST_TRANSFERS=false
PORT=4000
APP_ORIGIN=http://127.0.0.1:3000
API_INTERNAL_URL=http://127.0.0.1:4000
# Without DATABASE_URL, embedded PostgreSQL persists in .data/pixup.
# DATABASE_URL=postgresql://pixup:local-development-only@127.0.0.1:5432/pixup
DATA_DIR=.data/pixup
SEED_DEMO=true

# Optional persistent Ed25519 PKCS8 PEM (literal \n escapes supported), server only.
# Without it the local CVM simulator command signing identity changes on restart.
CVM_COMMAND_PRIVATE_KEY=

# Local pilot policy (confirmed: 18+). This is self-attestation, not identity verification.
PILOT_MINIMUM_AGE=18
# Member-only text community. Provision scoped MFA moderators before enabling.
COMMUNITY_ENABLED=false
COMMUNITY_WRITES_ENABLED=false
# Structured logs exclude bodies, cookies, tokens, addresses and raw URLs.
TELEMETRY_LOGS=true
# Optional metrics scraper bearer token: generate at least 32 random characters.
# Audit-scoped staff can also read monitoring through their existing session.
MONITORING_TOKEN=
# Optional path to an independently provisioned PUBLIC Ed25519 trust store.
# Certificate/checkpoint private keys belong only on the separate offline signer.
CERT_TRUST_STORE=
# SaaS billing is separately enabled and always test-only. Plans require finance approval.
BILLING_PROVIDER=disabled
STRIPE_BILLING_WEBHOOK_SECRET=
# Private evidence: database is a local fallback; S3 mode also enables artwork quarantine.
EVIDENCE_STORAGE=database
MANAGED_ARTWORK=false
# Scanner must be independently installed/updated; no clean verdict is simulated by the API.
CLAMAV_SOCKET=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
# Requires approved physical captures for receipt/assessment and disables legacy demo dispatch.
PHYSICAL_CAPTURE_REQUIRED=false
# Backup tooling intentionally does not load this file. Supply explicit database
# destinations and PIXUP_BACKUP_KEY from a secret store when running those commands.

# Item 2 identity adapters are disabled until configured. Do not lose this encryption key.
# Generate locally with: openssl rand -hex 32
IDENTITY_ENCRYPTION_KEY=
IDENTITY_MAIL_PROVIDER=disabled
IDENTITY_MAIL_FROM=
RESEND_API_KEY=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
STAFF_MFA_REQUIRED=false
VERIFIED_INVITATIONS_REQUIRED=false
# Provision separate PostgreSQL logins/group grants; apply migrations before enabling.
DATABASE_HARDENED=false
DATABASE_MIGRATION_URL=
DATABASE_WORKER_URL=
