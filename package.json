{
  "name": "pixup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deps:install": "node scripts/install-dependencies.mjs install",
    "deps:ci": "node scripts/install-dependencies.mjs ci",
    "registry:check": "node scripts/install-dependencies.mjs check",
    "dev": "node scripts/run.mjs",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "next dev apps/web --hostname 127.0.0.1",
    "build": "npm run typecheck && next build apps/web",
    "start": "node scripts/run.mjs --production",
    "typecheck": "next typegen apps/web && tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "stripe:check": "node --import tsx scripts/stripe-check.ts",
    "stripe:refund-check": "node --import tsx scripts/stripe-refund-check.ts",
    "stripe:hosted-check": "node --import tsx scripts/stripe-hosted-check.ts",
    "stripe:controls-check": "node --import tsx scripts/stripe-controls-check.ts",
    "postgres:recovery-check": "node --import tsx scripts/postgres-recovery-check.ts",
    "format": "prettier --write apps packages scripts tests playwright.config.ts tsconfig.json package.json compose.yaml README.md docs/implementation-status.md",
    "cvm:sim": "node --import tsx scripts/cvm-simulator.ts",
    "ops:verify": "node --import tsx scripts/readiness-check.ts",
    "db:backup": "node --import tsx scripts/backup.ts backup",
    "db:restore": "node --import tsx scripts/backup.ts restore",
    "security:audit": "node scripts/security-audit.mjs",
    "trust:sign": "node --import tsx scripts/trust-sign.ts",
    "pricing:calibrate": "node --import tsx scripts/price-calibration.ts",
    "identity:bootstrap": "node --import tsx scripts/identity-bootstrap.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@tanstack/react-query": "5.104.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jose": "https://github.com/panva/jose/releases/download/v6.2.12/jose-6.2.12.tgz",
    "lucide-react": "1.44.0",
    "next": "16.4.2",
    "oauth4webapi": "https://github.com/panva/oauth4webapi/releases/download/v3.8.8/oauth4webapi-3.8.8.tgz",
    "openid-client": "https://github.com/panva/openid-client/releases/download/v6.8.8/openid-client-6.8.8.tgz",
    "postgres": "3.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.4.2",
    "tsx": "4.23.13",
    "typescript": "^5.9.3"
  }
}
